{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/random(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" } ] },
    { "source": "/(js|css)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ]
}